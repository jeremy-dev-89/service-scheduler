# Requests for the VS Code REST Client extension (humao.rest-client).
# Start the stack with `docker compose up --build`, then click "Send Request" above each block.
# IDs are the fixed seed IDs from src/infrastructure/database/seed/ids.ts.

@baseUrl = http://localhost:3000
@northsideMotors = 8b1f0c2e-0000-4000-8000-000000000001
@samCarter = 8b1f0c2e-0000-4000-8000-000000000101
@samCarterFocus = 8b1f0c2e-0000-4000-8000-000000000201
@jordanBlake = 8b1f0c2e-0000-4000-8000-000000000102
@jordanBlakeModel3 = 8b1f0c2e-0000-4000-8000-000000000202
@brakeReplacement = 8b1f0c2e-0000-4000-8000-000000000302
@evBatteryCheck = 8b1f0c2e-0000-4000-8000-000000000303

# Pick a future weekday within 90 days. Use +01:00 in British Summer Time, +00:00 otherwise.
@date = 2026-10-20
@startsAt = {{date}}T09:00:00+01:00

### Readiness (200, or 503 when the database is unreachable)
GET {{baseUrl}}/health/ready

### Book a brake replacement: 201 with a Location header
# @name book
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "dealershipId": "{{northsideMotors}}",
  "customerId": "{{samCarter}}",
  "vehicleId": "{{samCarterFocus}}",
  "serviceTypeId": "{{brakeReplacement}}",
  "startsAt": "{{startsAt}}"
}

### Read the stored appointment: 200
GET {{baseUrl}}/appointments/{{book.response.body.$.id}}

### Conflict: same slot, another customer. 409 SLOT_UNAVAILABLE with alternatives
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "dealershipId": "{{northsideMotors}}",
  "customerId": "{{jordanBlake}}",
  "vehicleId": "{{jordanBlakeModel3}}",
  "serviceTypeId": "{{brakeReplacement}}",
  "startsAt": "{{startsAt}}"
}

### Invalid input: startsAt without an offset. 400 VALIDATION_FAILED
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "dealershipId": "{{northsideMotors}}",
  "customerId": "{{samCarter}}",
  "vehicleId": "not-a-uuid",
  "serviceTypeId": "{{brakeReplacement}}",
  "startsAt": "{{date}}T09:00:00"
}

### Idempotent booking: send twice; the second returns 200 with Idempotent-Replayed: true
POST {{baseUrl}}/appointments
Content-Type: application/json
Idempotency-Key: demo-ev-check-1

{
  "dealershipId": "{{northsideMotors}}",
  "customerId": "{{jordanBlake}}",
  "vehicleId": "{{jordanBlakeModel3}}",
  "serviceTypeId": "{{evBatteryCheck}}",
  "startsAt": "{{date}}T14:00:00+01:00"
}

### Availability for brake replacement on a date: 200
GET {{baseUrl}}/dealerships/{{northsideMotors}}/availability?serviceTypeId={{brakeReplacement}}&date={{date}}

### Cancel the first booking: 200, and again 200 unchanged
POST {{baseUrl}}/appointments/{{book.response.body.$.id}}/cancel

### Prometheus metrics
GET {{baseUrl}}/metrics
