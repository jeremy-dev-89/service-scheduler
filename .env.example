# Copy to .env for local development. Values shown are the defaults.
NODE_ENV=development
PORT=3000
# Local development credentials only (matches docker-compose.yml).
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
DB_POOL_MAX=10
BOOKING_HORIZON_DAYS=90
BOOKING_MAX_ATTEMPTS=5
SLOT_STEP_MINUTES=15
ALTERNATIVES_COUNT=3
ALTERNATIVES_SEARCH_DAYS=7
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=unified-service-scheduler
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Host ports used by docker compose (change if 5432 or 3000 is taken on your machine).
DB_HOST_PORT=5432
API_HOST_PORT=3000
